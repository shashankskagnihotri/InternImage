            init_cfg=None),
        loss_cls=dict(
            type='CrossEntropyLoss',
            use_sigmoid=False,
            loss_weight=2.0,
            reduction='mean',
            class_weight=[1.0] * num_classes + [0.1])
    ),
    test_cfg=dict(mode='slide', crop_size=crop_size, stride=(512, 512)))
img_norm_cfg = dict(
