                pipeline=train_pipeline),
            dict(
                type=dataset_type,
                data_root=data_root,
                img_dir='leftImg8bit/train_extra',
                ann_dir='refinement_final_trainIds/train_extra',
                img_suffix='_leftImg8bit.png',
